# Copy to .env and fill in. Every key is optional: providers whose key is
# missing are simply disabled (config "enabled: auto"). Nothing in this repo
# imports keys at module import time; the offline test suite needs none.

# Candidate providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Judge provider (different family from candidates, by design)
GEMINI_API_KEY=

# Optional paid reference point (disabled by default in config/models.yaml)
OPENAI_API_KEY=

# Deliverable B: PolyglotBot
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=@polyglotbot:matrix.org
MATRIX_ACCESS_TOKEN=
